    "recipes.seed.bananaFingers.step1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heat the oven to 180°C and line a small tray."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panaskan ketuhar kepada 180°C dan alas dulang kecil."
          }
        }
      }
    },
    "recipes.seed.bananaFingers.step2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mash the bananas, then stir in the oats to a thick dough."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenyek pisang, kemudian gaulkan dengan oat hingga menjadi doh yang pekat."
          }
        }
      }
    },
    "recipes.seed.bananaFingers.step3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shape into finger lengths and place on the tray."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bentukkan memanjang seperti jari dan susun di atas dulang."
          }
        }
      }
    },
    "recipes.seed.bananaFingers.step4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bake for 15 minutes until set and lightly golden. Cool before serving."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakar selama 15 minit hingga pejal dan sedikit keemasan. Sejukkan sebelum dihidangkan."
          }
        }
      }
    },
