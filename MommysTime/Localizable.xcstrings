    "recipes.seed.bananaFingers.why" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft banana-oat fingers with no added sugar, sized for little hands learning to self-feed."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jejari pisang dan oat yang lembut tanpa gula tambahan, bersaiz sesuai untuk tangan kecil yang sedang belajar makan sendiri."
          }
        }
      }
    },
    "recipes.seed.oatBowl.step1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the oats and milk to a small pot over medium heat."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan oat dan susu ke dalam periuk kecil di atas api sederhana."
          }
        }
      }
    },
    "recipes.seed.oatBowl.step2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stir for 4–5 minutes until creamy and thickened."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kacau selama 4–5 minit hingga berkrim dan pekat."
          }
        }
      }
    },
    "recipes.seed.oatBowl.step3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take off the heat and fold through the Greek yoghurt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angkat dari api dan gaulkan yogurt Greek."
          }
        }
      }
    },
    "recipes.seed.oatBowl.step4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top with sliced banana, peanut butter and a dusting of cinnamon."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidangkan dengan hirisan pisang, mentega kacang dan sedikit serbuk kayu manis."
          }
        }
      }
    },
    "recipes.seed.oatBowl.tag" : {
