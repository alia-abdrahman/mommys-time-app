    },
    "village.seed.feeding.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switched this week after six weeks of trying to do it all by breast. She's fed, she's growing, and I slept four hours straight for the first time. Posting in case someone needs permission."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minggu ini saya beralih kepada penyusuan gabungan selepas enam minggu cuba menyusu badan sepenuhnya. Dia cukup makan, dia membesar, dan buat kali pertama saya dapat tidur empat jam tanpa terjaga. Saya kongsikan ini kalau ada yang perlukan sedikit keyakinan untuk membuat pilihan yang sama."
          }
        }
      }
    },
    "village.seed.feeding.meta" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baby 7 weeks · 5h ago"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayi 7 minggu · 5j lalu"
          }
        }
      }
    },
    "village.seed.feeding.reply1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I needed this today. Thank you for posting it."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya memang perlukan ini hari ini. Terima kasih kerana berkongsi."
          }
        }
      }
    },
    "village.seed.feeding.reply2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fed is fed. Four hours is huge — hope tonight gives you another."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang penting bayi cukup makan. Empat jam itu besar maknanya — semoga malam ini anda dapat lagi."
          }
        }
      }
    },
    "village.seed.feeding.reply3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did your supply settle after? Asking because I'm a week behind you."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekalan susu anda stabil selepas itu? Saya tanya sebab saya seminggu di belakang anda."
          }
        }
      }
    },
    "village.seed.feeding.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combi feeding and the guilt finally lifted"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyusuan gabungan dan rasa bersalah yang akhirnya reda"
          }
        }
      }
    },
    "village.seed.meTime.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First time since January. Put it in the app as a block so nobody could claim the slot. Came home a different person. What's your smallest win this week?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kali pertama sejak Januari. Saya masukkan dalam aplikasi sebagai satu blok supaya tiada siapa boleh ambil waktu itu. Balik rumah rasa macam orang baharu. Apa kemenangan kecil anda minggu ini?"
          }
        }
      }
    },
    "village.seed.meTime.meta" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baby 9 months · yesterday"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayi 9 bulan · semalam"
          }
        }
      }
    },
    "village.seed.meTime.reply1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shower with the door closed. Genuinely."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandi dengan pintu tertutup. Serius."
          }
        }
      }
    },
    "village.seed.meTime.reply2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocking the slot is the trick. If it isn't in the app someone else takes the hour."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuncinya memang tempah waktu itu. Kalau tak ada dalam aplikasi, orang lain akan ambil sejam itu."
          }
        }
      }
    },
    "village.seed.meTime.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Booked 40 minutes for a walk with no pram"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempah 40 minit untuk berjalan tanpa kereta sorong bayi"
          }
        }
      }
    },
    "village.seed.nights.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She settles in twenty minutes but I'm wide awake until five. Not looking for fixes — just needed to say it out loud somewhere that gets it."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dia lena dalam dua puluh minit, tapi saya pula berjaga sampai pukul lima. Saya bukan cari penyelesaian — cuma perlu luahkan di tempat yang memahami."
          }
        }
      }
    },
    "village.seed.nights.meta" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baby 4 months · 2h ago"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayi 4 bulan · 2j lalu"
          }
        }
      }
    },
    "village.seed.nights.reply1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitting with you. Week three of the same here. It does end, but that doesn't make tonight easier."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya faham. Di sini pun sudah masuk minggu ketiga perkara yang sama. Ia akan berlalu, tapi itu tak menjadikan malam ini lebih mudah."
          }
        }
      }
    },
    "village.seed.nights.reply2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saying it out loud counts. Hope you get a long stretch tonight."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melafazkannya pun sudah membantu. Semoga malam ini anda dapat tidur lebih lama."
          }
        }
      }
    },
    "village.seed.nights.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Third night of 3am wake-ups"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malam ketiga terjaga pukul 3 pagi"
          }
        }
      }
    },
