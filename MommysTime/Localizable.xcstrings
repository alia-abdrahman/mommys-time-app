    },
    "recipes.seed.porridge.step1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the chicken, rice, water and ginger to a large pot."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan ayam, beras, air dan halia ke dalam periuk besar."
          }
        }
      }
    },
    "recipes.seed.porridge.step2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring to a boil, then lower to a gentle simmer."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Didihkan, kemudian kecilkan api dan reneh perlahan."
          }
        }
      }
    },
    "recipes.seed.porridge.step3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook for 25 minutes, stirring now and then, until thick."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masak selama 25 minit sambil dikacau sekali-sekala hingga pekat."
          }
        }
      }
    },
    "recipes.seed.porridge.step4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shred the chicken, season with salt and scatter spring onion."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carik ayam, perasakan dengan garam dan taburkan daun bawang."
